 offers protection services for handset products through TecProtec products; management consulting, technology, and outsourcing services; and managing and customer relationship services. The company was founded in 1996 and is headquartered in Jakarta Barat, Indonesia. PT Erajaya Swasembada Tbk operates as a subsidiary of PT Eralink International.","fullTimeEmployees":21125,"companyOfficers":[{"maxAge":1,"name":"Mr. Budiarto  Halim","age":57,"title":"President Director","yearBorn":1968,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Sintawati  Halim","age":61,"title":"Director of Finance & Director","yearBorn":1964,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Amelia  Allen","age":44,"title":"Head of Legal Department & Corporate Secretary","yearBorn":1981,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Chee Ping Sim","age":54,"title":"Director of Business Development & Director","yearBorn":1971,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Djohan  Sutanto","age":53,"title":"Director of Sales & Director","yearBorn":1972,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Hendra  Wijaya","age":43,"title":"Head of Internal Audit","yearBorn":1982,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}}],"executiveTeam":[],"maxAge":86400},"summaryDetail":{"maxAge":1,"priceHint":{"raw":2,"fmt":"2","longFmt":"2"},"previousClose":{"raw":500.0,"fmt":"500.00"},"open":{"raw":505.0,"fmt":"505.00"},"dayLow":{"raw":498.0,"fmt":"498.00"},"dayHigh":{"raw":525.0,"fmt":"525.00"},"regularMarketPreviousClose":{"raw":500.0,"fmt":"5