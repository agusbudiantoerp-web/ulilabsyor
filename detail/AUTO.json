 and heat treatment services, as well as manufactures, sells, and trades in automotive parts; and manufactures and sells electrical appliances. It distributes its products through dealers, sales offices, and retailers. The company was formerly known as PT Astra Dian Lestari and changed its name to PT Astra Otoparts Tbk in November 1997. PT Astra Otoparts Tbk was founded in 1976 and is headquartered in Jakarta, Indonesia. PT Astra Otoparts Tbk is a subsidiary of PT Astra International Tbk.","fullTimeEmployees":6884,"companyOfficers":[{"maxAge":1,"name":"Mr. Yusak Kristian Solaeman","age":53,"title":"President Director","yearBorn":1972,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Handoyo  Prasetyo","title":"Director of Corp. Legal, Corp. Secretary & Public Relations","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. .  Suryaningrum","age":52,"title":"Chief Audit Executive","yearBorn":1973,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}}],"executiveTeam":[],"maxAge":86400},"summaryDetail":{"maxAge":1,"priceHint":{"raw":2,"fmt":"2","longFmt":"2"},"previousClose":{"raw":3120.0,"fmt":"3,120.00"},"open":{"raw":3110.0,"fmt":"3,110.00"},"dayLow":{"raw":3080.0,"fmt":"3,080.00"},"dayHigh":{"raw":3140.0,"fmt":"3,140.00"},"regularMarketPreviousClose":{"raw":3120.0,"fmt":"3,120.00"},"regularMarketOpen":{"raw":3110.0,"fmt":"3,110.00"},"regularMarketDayLow":{"raw":3080.0,"fmt":"3,080.00"},"regularMarketDayHigh":{"raw":3140.0,"fmt":"3,140.00"},"dividendRate":{"raw":242.52,"fmt":"242.52"},"dividendYield":{"raw":0.0777,"fmt":"7.77%"},"exDividendDate":{"raw":1791936000,"fmt":"2026-10-14"},"payoutRatio":{"raw":0.45349997,"fmt":"45.35%"},"fiveYearAvgDividendYield":{"raw":5.18,"fmt":"5.18"},"beta":{"raw":0.111,"fmt":"0.11"},"trailingPE":{"raw":6.158416,"fmt":"6.16"},"forw