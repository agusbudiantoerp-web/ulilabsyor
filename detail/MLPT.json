ices, including API management and service-oriented architecture, application development platform, database platform, enterprise application platform, banking integration, cloud platform, and IoT services. It serves the banking, insurance, multi-finance, securities, fintech, telecommunication, public sector, healthcare, education, oil and gas, retail, and manufacturing sectors. The company was founded in 1975 and is headquartered in Jakarta, Indonesia. PT Multipolar Technology Tbk operates as a subsidiary of PT Multipolar Tbk.","fullTimeEmployees":953,"companyOfficers":[{"maxAge":1,"name":"Mr. Harianto  Gunawan","title":"President Director","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Hanny  Untar","age":61,"title":"Director of Finance, Accounting & Corporate Services","yearBorn":1964,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Suyanto  Halim","age":55,"title":"Director of Business Development & Director","yearBorn":1970,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. .  Herryyanto","age":53,"title":"Director of Account Management FSI & Commercial and Director","yearBorn":1972,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Mr. Yugi  Edison","age":55,"title":"Director of Account Management Telco & Public Sector and Director","yearBorn":1970,"exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Monica Pamela Citranagari CRA","title":"Head of Internal Audit","exercisedValue":{"raw":0,"fmt":null,"longFmt":"0"},"unexercisedValue":{"raw":0,"fmt":null,"longFmt":"0"}},{"maxAge":1,"name":"Ms. Natalie  Lie","age":43,"title":"Corporate Secretary","yearBorn":1982,"exercis